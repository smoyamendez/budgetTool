{
  "name": "budget-tool",
  "version": "0.1.0",
  "description": "Payday: a pay-cycle budget app. Frontend on GitHub Pages, backend on Cloudflare Workers + D1, banks through Plaid.",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply payday --local",
    "db:migrate": "wrangler d1 migrations apply payday --remote",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.0"
  },
  "private": true,
  "license": "UNLICENSED"
}
