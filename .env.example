# Copy this file to .env and fill in your keys from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (fake banks, free) or production (your real accounts)
PLAID_ENV=sandbox
# Only needed for banks that sign in through their own site (OAuth). Must also be added in the Plaid dashboard.
PLAID_REDIRECT_URI=
PORT=3000
# Where your budget and Plaid connections are saved. Keep this folder private.
DATA_DIR=./data
